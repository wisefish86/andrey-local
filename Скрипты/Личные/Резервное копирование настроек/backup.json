{
  "version": 1,
  "destination": "D:\\YandexDisk\\Архив\\Backup\\Программы",
  "items": [
    {
      "name": "Flow Launcher",
      "files": [
        {
          "source": "%APPDATA%\\FlowLauncher\\Settings\\Favorites.conf",
          "target": "Flow Launcher/Favorites.conf"
        }
      ]
    },
    {
      "name": "Espanso",
      "files": [
        {
          "source": "%APPDATA%\\espanso\\match\\base.yml",
          "target": "Espanso/match/base.yml"
        },
        {
          "source": "%APPDATA%\\espanso\\config\\default.yml",
          "target": "Espanso/config/default.yml"
        }
      ]
    },
    {
      "name": "CorelDRAW GMS",
      "discovery": {
        "root": "%APPDATA%\\Corel",
        "pattern": "*.gms",
        "targetPrefix": "CorelDRAW",
        "skipWhenProcessesRunning": [
          "CorelDRW",
          "CorelDRAW"
        ]
      }
    },
    {
      "name": "Adobe Photoshop",
      "discovery": {
        "root": "%APPDATA%\\Adobe",
        "pattern": "*",
        "patterns": [
          "Actions Palette.psp",
          "*.atn",
          "*.psp",
          "*.abr",
          "*.asl",
          "*.pat",
          "*.grd",
          "*.csh",
          "*.tpl",
          "*.aco",
          "*.ase",
          "*.kys",
          "*.mnu",
          "*.csf",
          "*.psf",
          "*.acv",
          "*.jsx",
          "*.jsxbin",
          "*.json"
        ],
        "includePathRegex": "^Adobe Photoshop [^\\\\]+\\\\",
        "targetPrefix": "Photoshop",
        "skipWhenProcessesRunning": [
          "Photoshop"
        ]
      }
    }
  ],
  "schedule": {
    "mode": "daily",
    "time": "21:00",
    "intervalHours": 3
  }
}
